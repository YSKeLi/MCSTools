{
  "name": "minecraft-server-tools",
  "version": "1.0.5",
  "description": "Cross-platform Minecraft server toolkit.",
  "author": {
    "name": "YSKeLi",
    "email": "110509979+YSKeLi@users.noreply.github.com"
  },
  "homepage": "https://github.com/YSKeLi/MCSTools",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YSKeLi/MCSTools.git"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "main": "dist/main/index.js",
  "scripts": {
    "prepare:electron": "node scripts/prepare-electron.cjs",
    "postinstall": "npm run prepare:electron",
    "dev": "npm run prepare:electron && npm run build:main && concurrently -k \"tsc -p tsconfig.main.json --watch --preserveWatchOutput\" \"vite\" \"wait-on tcp:5173 && electron dist/main/index.js\"",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "tsc -p tsconfig.main.json && vite build",
    "verify": "npm run typecheck && npm test",
    "test": "npm run build:main && node --test tests/*.test.cjs",
    "dist": "npm run prepare:electron && npm run build && node scripts/run-electron-builder.cjs",
    "dist:win": "powershell -ExecutionPolicy Bypass -File scripts/build-installer.ps1",
    "dist:win:unsigned": "powershell -ExecutionPolicy Bypass -File scripts/build-installer.ps1 -AllowUnsigned",
    "audit": "npm audit --registry=https://registry.npmjs.org",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "extract-zip": "^2.0.1",
    "lucide-react": "^1.26.0",
    "opencc-js": "^1.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ssh2": "^1.17.0",
    "systeminformation": "^5.33.0",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/ssh2": "^1.15.5",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^8.2.2",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.7",
    "typescript": "^5.5.4",
    "vite": "^5.4.8",
    "wait-on": "^8.0.1"
  }
}
